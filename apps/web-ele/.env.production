VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=http://8.148.205.221:4000/api/v1
VITE_BASE_API= http://8.148.205.221:4000
# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# React子应用地址
